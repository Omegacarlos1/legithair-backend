{
  "info": { "name": "Legit Hair Backend B01-B02", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    {
      "name": "Health - positive",
      "request": { "method": "GET", "header": [{ "key": "X-Request-Id", "value": "{{requestId}}" }], "url": "{{baseUrl}}/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('healthy envelope', () => { const b=pm.response.json(); pm.expect(b.success).to.eql(true); pm.expect(b.data.status).to.eql('ok'); pm.expect(b.meta.requestId).to.eql(pm.environment.get('requestId')); });"] } }]
    },
    {
      "name": "Ready - positive when MariaDB is running",
      "request": { "method": "GET", "url": "{{baseUrl}}/ready" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('database available', () => pm.expect(pm.response.json().data.database).to.eql('available'));" ] } }]
    },
    {
      "name": "Ready - negative when MariaDB is stopped",
      "request": { "method": "GET", "url": "{{baseUrl}}/ready" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 503', () => pm.response.to.have.status(503));", "pm.test('safe error', () => { const b=pm.response.json(); pm.expect(b.error.code).to.eql('SERVICE_UNAVAILABLE'); pm.expect(pm.response.text()).not.to.include('DATABASE_PASSWORD'); });" ] } }]
    },
    {
      "name": "B02 Register - positive",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{registrationEmail}}\",\"password\":\"ValidPass123!\",\"displayName\":\"Postman Customer\"}" }, "url": "{{baseUrl}}/api/v1/auth/register" },
      "event": [
        { "listen": "prerequest", "script": { "exec": ["const liveRecipient = pm.environment.get('gmailRecipient');", "pm.environment.set('registrationEmail', liveRecipient || (pm.variables.replaceIn('{{$randomUUID}}') + '@example.test'));" ] } },
        { "listen": "test", "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "pm.test('user fixture returned', () => pm.expect(pm.response.json().data.userId).to.be.a('string'));" ] } }
      ]
    },
    {
      "name": "B02 Resend verification - enumeration safe",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{registrationEmail}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/resend-verification" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 202', () => pm.response.to.have.status(202));", "pm.test('safe response', () => pm.expect(pm.response.json().data.message).to.include('If the account exists'));" ] } }]
    },
    {
      "name": "B02 Verify email token",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"token\":\"{{verificationToken}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/verify-email" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('email verified', () => pm.expect(pm.response.json().data.verified).to.eql(true));" ] } }]
    },
    {
      "name": "B02 Register - invalid",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"invalid\",\"password\":\"short\",\"displayName\":\"\"}" }, "url": "{{baseUrl}}/api/v1/auth/register" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 400', () => pm.response.to.have.status(400));", "pm.test('validation envelope', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));" ] } }]
    },
    {
      "name": "B02 Login seeded customer",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{fixtureEmail}}\",\"password\":\"{{fixturePassword}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/login" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "const b=pm.response.json(); pm.environment.set('accessToken', b.data.tokens.accessToken); pm.environment.set('refreshToken', b.data.tokens.refreshToken); pm.environment.set('customerId', b.data.user.id);" ] } }]
    },
    {
      "name": "B02 Me - positive",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/me" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('own fixture', () => pm.expect(pm.response.json().data.user.id).to.eql(pm.environment.get('customerId')));" ] } }]
    },
    {
      "name": "B02 Me - unauthenticated",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/me" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));", "pm.test('unauthenticated', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));" ] } }]
    },
    {
      "name": "B02 Other customer's addresses - forbidden",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/users/{{otherCustomerId}}/addresses" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));", "pm.test('forbidden', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));" ] } }]
    }
  ]
}
