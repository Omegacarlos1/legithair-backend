{
  "info": { "name": "Legit Hair Backend B01-B04", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    {
      "name": "Health - positive",
      "request": { "method": "GET", "header": [{ "key": "X-Request-Id", "value": "{{requestId}}" }], "url": "{{baseUrl}}/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('healthy envelope', () => { const b=pm.response.json(); pm.expect(b.success).to.eql(true); pm.expect(b.data.status).to.eql('ok'); pm.expect(b.meta.requestId).to.eql(pm.environment.get('requestId')); });"] } }]
    },
    {
      "name": "Ready - positive when MariaDB is running",
      "request": { "method": "GET", "url": "{{baseUrl}}/ready" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('database available', () => pm.expect(pm.response.json().data.database).to.eql('available'));" ] } }]
    },
    {
      "name": "Ready - negative when MariaDB is stopped",
      "request": { "method": "GET", "url": "{{baseUrl}}/ready" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 503', () => pm.response.to.have.status(503));", "pm.test('safe error', () => { const b=pm.response.json(); pm.expect(b.error.code).to.eql('SERVICE_UNAVAILABLE'); pm.expect(pm.response.text()).not.to.include('DATABASE_PASSWORD'); });" ] } }]
    },
    {
      "name": "B02 Register - positive",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{registrationEmail}}\",\"password\":\"ValidPass123!\",\"displayName\":\"Postman Customer\"}" }, "url": "{{baseUrl}}/api/v1/auth/register" },
      "event": [
        { "listen": "prerequest", "script": { "exec": ["const liveRecipient = pm.environment.get('gmailRecipient');", "pm.environment.set('registrationEmail', liveRecipient || (pm.variables.replaceIn('{{$randomUUID}}') + '@example.test'));" ] } },
        { "listen": "test", "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "pm.test('user fixture returned', () => pm.expect(pm.response.json().data.userId).to.be.a('string'));" ] } }
      ]
    },
    {
      "name": "B02 Resend verification - enumeration safe",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{registrationEmail}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/resend-verification" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 202', () => pm.response.to.have.status(202));", "pm.test('safe response', () => pm.expect(pm.response.json().data.message).to.include('If the account exists'));" ] } }]
    },
    {
      "name": "B02 Verify email token",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"token\":\"{{verificationToken}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/verify-email" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('email verified', () => pm.expect(pm.response.json().data.verified).to.eql(true));" ] } }]
    },
    {
      "name": "B02 Register - invalid",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"invalid\",\"password\":\"short\",\"displayName\":\"\"}" }, "url": "{{baseUrl}}/api/v1/auth/register" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 400', () => pm.response.to.have.status(400));", "pm.test('validation envelope', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));" ] } }]
    },
    {
      "name": "B02 Login seeded customer",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{fixtureEmail}}\",\"password\":\"{{fixturePassword}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/login" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "const b=pm.response.json(); pm.environment.set('accessToken', b.data.tokens.accessToken); pm.environment.set('refreshToken', b.data.tokens.refreshToken); pm.environment.set('customerId', b.data.user.id);" ] } }]
    },
    {
      "name": "B02 Me - positive",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/me" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('own fixture', () => pm.expect(pm.response.json().data.user.id).to.eql(pm.environment.get('customerId')));" ] } }]
    },
    {
      "name": "B02 Me - unauthenticated",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/me" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));", "pm.test('unauthenticated', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));" ] } }]
    },
    {
      "name": "B02 Other customer's addresses - forbidden",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/users/{{otherCustomerId}}/addresses" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));", "pm.test('forbidden', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));" ] } }]
    },
    {
      "name": "B03 Create seller - positive",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"businessName\":\"Postman Synthetic Hair Store\",\"phone\":\"+2348000000000\"}" }, "url": "{{baseUrl}}/api/v1/sellers" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "const b=pm.response.json(); pm.environment.set('sellerId', b.data.seller.id);", "pm.test('states remain separate', () => { pm.expect(b.data.seller.identityStatus).to.eql('not_started'); pm.expect(b.data.seller.approvalStatus).to.eql('pending'); });" ] } }]
    },
    {
      "name": "B03 Get own seller - positive",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/sellers/me" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('own seller', () => pm.expect(pm.response.json().data.seller.id).to.eql(pm.environment.get('sellerId')));" ] } }]
    },
    {
      "name": "B03 Verification - provider deferred",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/api/v1/sellers/me/verification" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 503', () => pm.response.to.have.status(503));", "pm.test('explicit provider gate', () => pm.expect(pm.response.json().error.code).to.eql('IDENTITY_PROVIDER_NOT_CONFIGURED'));" ] } }]
    },
    {
      "name": "B03 Login seeded admin",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{fixturePassword}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/login" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "const b=pm.response.json(); pm.environment.set('adminAccessToken', b.data.tokens.accessToken);", "pm.test('admin role present', () => pm.expect(b.data.user.roles).to.include('admin'));" ] } }]
    },
    {
      "name": "B03 Approve seller - verification required",
      "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"approved\",\"reason\":\"Postman synthetic approval attempt\"}" }, "url": "{{baseUrl}}/api/v1/admin/sellers/{{sellerId}}/status" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 409', () => pm.response.to.have.status(409));", "pm.test('verification required', () => pm.expect(pm.response.json().error.code).to.eql('IDENTITY_VERIFICATION_REQUIRED'));" ] } }]
    },
    {
      "name": "B03 Suspend seller - positive",
      "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"suspended\",\"reason\":\"Postman synthetic compliance hold\"}" }, "url": "{{baseUrl}}/api/v1/admin/sellers/{{sellerId}}/status" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('seller suspended', () => pm.expect(pm.response.json().data.seller.approvalStatus).to.eql('suspended'));" ] } }]
    },
    {
      "name": "B03 Suspended seller verification - forbidden",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/api/v1/sellers/me/verification" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));", "pm.test('suspension enforced', () => pm.expect(pm.response.json().error.code).to.eql('SELLER_SUSPENDED'));" ] } }]
    },
    {
      "name": "B04 Login seeded admin",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{fixturePassword}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/login" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "const b=pm.response.json(); pm.environment.set('adminAccessToken', b.data.tokens.accessToken);", "pm.test('admin role', () => pm.expect(b.data.user.roles).to.include('admin'));" ] } }]
    },
    {
      "name": "B04 Create category - admin positive",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Postman Hair {{$randomInt}}\"}" }, "url": "{{baseUrl}}/api/v1/admin/categories" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "const b=pm.response.json(); pm.environment.set('categoryId', b.data.category.id);" ] } }]
    },
    {
      "name": "B04 Login synthetic approved seller",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{sellerEmail}}\",\"password\":\"{{fixturePassword}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/login" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "const b=pm.response.json(); pm.environment.set('sellerAccessToken', b.data.tokens.accessToken);", "pm.test('synthetic seller role', () => pm.expect(b.data.user.roles).to.include('seller'));" ] } }]
    },
    {
      "name": "B04 Create draft product - seller positive",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{sellerAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"categoryId\":\"{{categoryId}}\",\"name\":\"Postman Brazilian Wig\",\"description\":\"Synthetic Postman catalogue product with one configuration.\",\"priceMinor\":125000,\"brand\":\"Legit Synthetic\",\"colour\":\"Black\",\"size\":\"Medium\",\"lowStockThreshold\":2,\"initialStock\":5}" }, "url": "{{baseUrl}}/api/v1/seller/products" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "const b=pm.response.json(); pm.environment.set('productId', b.data.product.id);", "pm.test('starts as draft', () => pm.expect(b.data.product.publicationStatus).to.eql('draft'));" ] } }]
    },
    {
      "name": "B04 Draft product hidden - public negative",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products/{{productId}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 404', () => pm.response.to.have.status(404));", "pm.test('draft hidden', () => pm.expect(pm.response.json().error.code).to.eql('PRODUCT_NOT_FOUND'));" ] } }]
    },
    {
      "name": "B04 Upload product image - seller positive",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{sellerAccessToken}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "altText", "value": "Postman synthetic product image", "type": "text" }, { "key": "sortOrder", "value": "0", "type": "text" }, { "key": "image", "type": "file", "src": "{{productImagePath}}" }] }, "url": "{{baseUrl}}/api/v1/seller/products/{{productId}}/images" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "const b=pm.response.json(); pm.environment.set('imageId', b.data.image.id);", "pm.test('validated image metadata', () => pm.expect(['image/jpeg','image/png','image/webp']).to.include(b.data.image.mimeType));" ] } }]
    },
    {
      "name": "B04 Upload missing image - negative",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{sellerAccessToken}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "altText", "value": "Missing image field", "type": "text" }] }, "url": "{{baseUrl}}/api/v1/seller/products/{{productId}}/images" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 400', () => pm.response.to.have.status(400));", "pm.test('image required', () => pm.expect(pm.response.json().error.code).to.eql('IMAGE_REQUIRED'));" ] } }]
    },
    {
      "name": "B04 Publish product - seller positive",
      "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{sellerAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"published\"}" }, "url": "{{baseUrl}}/api/v1/seller/products/{{productId}}/publication" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('published', () => pm.expect(pm.response.json().data.product.publicationStatus).to.eql('published'));" ] } }]
    },
    {
      "name": "B04 Browse filtered products - public positive",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products?page=1&limit=20&brand=Legit%20Synthetic&colour=Black&size=Medium&sort=price_asc" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('product visible', () => pm.expect(pm.response.json().data.products.map(p => p.id)).to.include(pm.environment.get('productId')));", "pm.test('pagination returned', () => pm.expect(pm.response.json().meta.pagination.page).to.eql(1));" ] } }]
    },
    {
      "name": "B04 Adjust stock - idempotent positive",
      "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{sellerAccessToken}}" }, { "key": "Idempotency-Key", "value": "{{stockIdempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"delta\":-1,\"reason\":\"Postman synthetic stock decrement\"}" }, "url": "{{baseUrl}}/api/v1/seller/products/{{productId}}/stock" },
      "event": [{ "listen": "prerequest", "script": { "exec": ["if (!pm.environment.get('stockIdempotencyKey')) pm.environment.set('stockIdempotencyKey', 'postman-stock-' + pm.variables.replaceIn('{{$randomUUID}}'));" ] } }, { "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('first application', () => pm.expect(pm.response.json().data.adjustment.idempotentReplay).to.eql(false));" ] } }]
    },
    {
      "name": "B04 Replay stock adjustment - idempotent positive",
      "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{sellerAccessToken}}" }, { "key": "Idempotency-Key", "value": "{{stockIdempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"delta\":-1,\"reason\":\"Repeated Postman request\"}" }, "url": "{{baseUrl}}/api/v1/seller/products/{{productId}}/stock" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('safe replay', () => pm.expect(pm.response.json().data.adjustment.idempotentReplay).to.eql(true));" ] } }]
    },
    {
      "name": "B04 Login synthetic other seller",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{otherSellerEmail}}\",\"password\":\"{{fixturePassword}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/login" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.environment.set('otherSellerAccessToken', pm.response.json().data.tokens.accessToken);" ] } }]
    },
    {
      "name": "B04 Other seller stock - forbidden",
      "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{otherSellerAccessToken}}" }, { "key": "Idempotency-Key", "value": "postman-cross-seller-001" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"delta\":1,\"reason\":\"Cross seller attempt\"}" }, "url": "{{baseUrl}}/api/v1/seller/products/{{productId}}/stock" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));", "pm.test('ownership enforced', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));" ] } }]
    }
  ]
}
