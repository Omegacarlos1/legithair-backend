NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=legit_hair_app
DATABASE_PASSWORD=replace_with_local_password
DATABASE_NAME=legit_hair_development
DATABASE_CONNECTION_LIMIT=10
READINESS_TIMEOUT_MS=1500
# B02 uses opaque database-backed tokens; no signing secret is required.
EMAIL_PROVIDER=fake
EMAIL_FROM_NAME=Legit Hair
# For local Gmail delivery, set EMAIL_PROVIDER=gmail and provide these only in .env.
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=replace_with_16_character_app_password
EMAIL_WORKER_POLL_MS=2000
EMAIL_JOB_LOCK_TIMEOUT_SECONDS=300
# Required before admin marketing campaign creation; use the public API unsubscribe endpoint.
MARKETING_UNSUBSCRIBE_BASE_URL=
# B11 Socket.IO outbox worker lease and polling controls.
REALTIME_OUTBOX_POLL_MS=250
OUTBOX_LOCK_TIMEOUT_SECONDS=30
# B03 Dojah identity verification is intentionally not configured; check type and consent remain unresolved.
IMAGE_STORAGE_ROOT=storage/product-images
IMAGE_MAX_BYTES=5242880
GUEST_BASKET_TTL_DAYS=30
CHECKOUT_QUOTE_TTL_SECONDS=900
# B06 production policy must be owner-approved before setting these values.
ORDER_RESERVATION_TTL_SECONDS=
ORDER_COMMISSION_BASIS=
ORDER_COMMISSION_RATE_BPS=
COD_ENABLED=false
# Generate a distinct secret of at least 32 characters; never commit the real value.
ORDER_GUEST_TOKEN_SECRET=
# B07: use only a server-side Paystack secret. Never expose or commit the real value.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=
PAYSTACK_TIMEOUT_MS=10000
# B08 production return/refund policy must be owner-approved before setting these values.
RETURN_WINDOW_DAYS=
# Allowed values: never or full_order. Empty keeps refund approval fail-closed.
REFUND_DELIVERY_MODE=
# Test-mode refund acceptance only; use a completed disposable test transaction.
PAYSTACK_REFUND_ACCEPTANCE_TRANSACTION=
PAYSTACK_REFUND_ACCEPTANCE_AMOUNT_MINOR=
# B09 production values require owner approval. Empty hold duration prevents accrual;
# payouts remain disabled even when a Paystack secret is present.
EARNINGS_HOLD_DAYS=
PAYOUTS_ENABLED=false
# B10 reviews, banners, and reports add no provider credentials or policy defaults.
