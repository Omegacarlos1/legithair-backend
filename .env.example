NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=legit_hair_app
DATABASE_PASSWORD=replace_with_local_password
DATABASE_NAME=legit_hair_development
DATABASE_CONNECTION_LIMIT=10
READINESS_TIMEOUT_MS=1500
# B02 uses opaque database-backed tokens; no signing secret is required.
EMAIL_PROVIDER=fake
EMAIL_FROM_NAME=Legit Hair
# For local Gmail delivery, set EMAIL_PROVIDER=gmail and provide these only in .env.
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=replace_with_16_character_app_password
EMAIL_WORKER_POLL_MS=2000
# B03 Dojah identity verification is intentionally not configured; check type and consent remain unresolved.
IMAGE_STORAGE_ROOT=storage/product-images
IMAGE_MAX_BYTES=5242880
GUEST_BASKET_TTL_DAYS=30
CHECKOUT_QUOTE_TTL_SECONDS=900
